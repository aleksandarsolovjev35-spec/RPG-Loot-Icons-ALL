__pycache__/
.venv/

# Icon sets are versioned on purpose:
#   cut_icons/        - 4100 palette PNGs, output of tools/cut_icons.py
#   icons-512/        - 4100 WebP 512x512 + manifest.json, output of tools/repack_icons.py
#   icons-256-base/   - 4100 WebP 256x256 + manifest.json, the clean base set
#                       (tools/repack_icons.py --size 256 ... --out icons-256-base)
#   icons-256/        - the actual set: the base with quiet+vign baked in
#                       (tools/stylize.py --set icons-256-base --apply quiet+vign)
#                       - 12.4% smaller files, role=actual in its manifest
#   icons-256-v2/     - candidate for the next actual set: the base with
#                       quiet+flat+vign+fit+punch (tools/audit_set.py found the
#                       base's exposure/contrast/saturation still all over the
#                       place; see docs/quality-lab/) - role=candidate in its
#                       manifest, nothing in the repo points at it yet
# All of them are reproducible from the 82 sheets in the repo root, but they are
# kept in git so a clone works offline without running the toolchain.
